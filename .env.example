# Elasticsearch Configuration
ES_HOST=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=changeme  # CHANGE THIS - use your actual ES password

# vLLM Server Configuration (EQuIP_3B via vLLM)
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=EQuIP-Queries/EQuIP_3B

# LLM Parameters (for reproducibility)
LLM_TEMPERATURE=0.1      # Low temperature for deterministic DSL generation
LLM_MAX_TOKENS=500       # Sufficient for most Query DSL responses

# Elasticsearch Indices (MOI data)
ES_INDEX_PERSON=person_details
ES_INDEX_VEHICLE=vehicle
ES_INDEX_VIOLATIONS=violations
